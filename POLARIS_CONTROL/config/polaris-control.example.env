POLARIS_BIND=127.0.0.1:49153
POLARIS_STORAGE_PATH=/root/POLARIS_CONTROL
POLARIS_WEB_DIR=/root/POLARIS_CONTROL/apps/web/dist
POLARIS_EXECUTION_MODE=live
# Explicit deployment-time authorization for bounded desired-count reconciliation. Keep false until reviewed activation.
POLARIS_ADDITIONAL_UE_LIVE_ENABLED=false
# Required for additional UEs: a deployment-unique 64-character lowercase hex value, stored only in the mode-0600 live env file.
POLARIS_UE_OWNERSHIP_ID=
POLARIS_AUDIT_PATH=/var/log/polaris-control/audit.jsonl
POLARIS_JOB_STATE_PATH=/var/lib/polaris-control/jobs.json
POLARIS_UE_JOB_STATE_PATH=/var/lib/polaris-control/ue-jobs.json
POLARIS_CONFIGURATION_PATH=/var/lib/polaris-control/configuration.json
POLARIS_POLICY_PATH=/var/lib/polaris-control/scenario-policy.json
POLARIS_USERS_PATH=/var/lib/polaris-control/users.json
# Provision Operator/Administrator accounts with target/release/polaris-userctl.
# Never place passwords in this environment file.
